# Copy this file to .env and fill in real values. .env is gitignored.

# ---- Django ----
DEBUG=True
DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=*

# ---- Supabase Postgres ----
# Supabase dashboard → Project Settings → Database → Connection string (URI).
# Use the "Transaction" pooler URI (port 6543) for serverless/Vercel.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---- Supabase API keys ----
# Supabase dashboard → Project Settings → API → Project API keys.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
